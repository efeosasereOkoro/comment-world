# Supabase project (public — safe in the browser; RLS governs access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the embeddable widget is served from. The dashboard puts this in the
# copy-paste embed snippet. Use your CDN URL in production; for local testing point
# it at the built file, e.g. http://localhost:4180/packages/widget/dist/widget.js
NEXT_PUBLIC_WIDGET_SRC=https://cdn.commentbox.app/widget.js
